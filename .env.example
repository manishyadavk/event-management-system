# Copy to .env and fill in. NEVER commit .env.
PORT=3000

# Used to sign login tokens (any long random string, 16+ chars). Required.
SESSION_SECRET=
# Admin login password for the admin panel
ADMIN_PASSWORD=
# Password given to the seeded demo students (default Student@123). Demo data only.
DEMO_STUDENT_PASSWORD=

# --- LLM: set ONE of the two keys. GEMINI_API_KEY (Google AI Studio) takes priority if both are set. ---
# Get a Gemini key (free tier available) at https://aistudio.google.com/apikey - NOT the Google Calendar OAuth keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Or Anthropic Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Calendar API (OAuth 2.0) ---
# Create an OAuth client (type "Web application") in Google Cloud Console, enable the
# Google Calendar API, add redirect URI http://localhost:3001/oauth2callback, then run:
#   npm run google-auth     (prints GOOGLE_REFRESH_TOKEN)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
EVENT_TIMEZONE=Asia/Kolkata
EVENT_DURATION_MINUTES=120

# Optional
# DB_PATH=./events.db
# LOGIN_RATE_LIMIT=10
