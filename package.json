{
  "name": "ai-event-management-system",
  "version": "1.0.0",
  "description": "AI-powered college event management system (Express + SQLite + Claude agent + Google Calendar)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "google-auth": "node scripts/google-auth.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0"
  }
}
